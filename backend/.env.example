NODE_ENV=development
TUTORIA_ENVIRONMENT=development
HOST=127.0.0.1
PORT=4000
FRONTEND_ORIGINS=http://localhost:4173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Worker-only authority. Keep this secret; never expose it to browser builds.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Comma-separated list of allowed image hostnames for media uploads.
# Examples: picsum.photos,images.unsplash.com
# ALLOWED_IMAGE_HOSTS=picsum.photos,images.unsplash.com
VNPAY_ENVIRONMENT=sandbox
# VNPAY_TMN_CODE=your-sandbox-tmn-code
# VNPAY_HASH_SECRET=your-sandbox-hash-secret
# VNPAY_RETURN_URL=https://your-frontend.example.com/payments/return
# VNPAY_IPN_URL=https://your-api.example.com/api/v1/payments/vnpay/ipn
# VNPAY_REQUEST_TIMEOUT_MS=15000
TRUST_PROXY=false
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
ME_RATE_LIMIT_MAX=30
TUTOR_CV_GET_RATE_LIMIT_MAX=60
TUTOR_CV_SAVE_RATE_LIMIT_MAX=20
TUTOR_CV_PUBLISH_RATE_LIMIT_MAX=10
PUBLIC_TUTORS_LIST_RATE_LIMIT_MAX=60
PUBLIC_TUTOR_DETAIL_RATE_LIMIT_MAX=120
# Direct host<->learner messaging rate limits (per window, default 60s).
# Optional — defaults apply if unset (read 120, send 30).
MESSAGING_READ_RATE_LIMIT_MAX=120
MESSAGING_SEND_RATE_LIMIT_MAX=30
REQUEST_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=5000
BODY_LIMIT_BYTES=16384
MAX_AUTHORIZATION_HEADER_LENGTH=8192
# Durable financial recovery worker (Phase 3). Runs the refund execution /
# reconciliation / finalize sweeps; requires the service-role key + VNPay.
# FINANCIAL_WORKER_INTERVAL_MS=60000
# FINANCIAL_WORKER_BATCH_SIZE=50
# FINANCIAL_WORKER_LEASE_SECONDS=300
# FINANCIAL_WORKER_RELEASE_BACKOFF_SECONDS=60
# FINANCIAL_WORKER_WORKER_ID=financial-recovery-01
# FINANCIAL_WORKER_LOG_LEVEL=info
# Sentry error tracking (optional — leave empty to disable)
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Integration tests (test-integration/). These point at a LOCAL Supabase only;
# the tests refuse to run against a non-local target. See
# vitest.integration.config.ts + test-integration/auth-helpers.ts.
# SUPABASE_TEST_URL=http://127.0.0.1:54321
# SUPABASE_TEST_PUBLISHABLE_KEY=your-local-publishable-key
# SUPABASE_TEST_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# SUPABASE_TEST_SERVICE_ROLE_KEY=your-local-service-role-key
# SUPABASE_TEST_JWT_SECRET=your-local-jwt-secret (must match supabase/config.toml)
